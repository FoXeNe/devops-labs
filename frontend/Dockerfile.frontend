# фронт у нас это один статический index.html, собирать нечего, поэтому сразу nginx.
# собирается из корня:
#   docker build -f frontend/Dockerfile.frontend -t notes-frontend .

FROM nginx:1.27.4-alpine AS runtime

# свой конфиг, в нем проксирование /api на сервис backend
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY --chown=nginx:nginx frontend/index.html /usr/share/nginx/html/index.html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

# nginx в этом образе стартует от root, чтобы занять 80 порт, и дальше сам
# сбрасывает привилегии до nginx
CMD ["nginx", "-g", "daemon off;"]
