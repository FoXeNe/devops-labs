# Контекст сборки — корень репозитория, поэтому этот файл лежит в корне.
# Отсекает всё, что не должно попадать в образ: и ради размера, и ради кеша,
# и ради безопасности (чтобы .env с паролями и .git с историей не уехали внутрь).

# git и мусор IDE
.git
.gitignore
.github
.idea
.vscode
*.swp

# локальные окружения и питон-мусор
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# локальная бд и данные
.pgdata
pgdata

# секреты: внутрь образа им нельзя
.env
**/.env
*.pem
*.key

# документация, отчёты, скриншоты, чужие лабы
docs
lab1
lab3
**/*.md
lab2/docs
lab2/REPORT.md

# мусор ОС
.DS_Store
Thumbs.db
*.log
